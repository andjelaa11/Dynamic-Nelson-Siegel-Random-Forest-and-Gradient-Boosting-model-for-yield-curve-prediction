def _normalise_column_name(column_name):
    """
    Normalizuje nazive kolona samo za pronalazenje obaveznih polja.
    """

    return (
        str(column_name)
        .strip()
        .lower()
        .replace(" ", "")
        .replace("_", "")
        .replace("-", "")
    )


def _maturity_key(column_name):
    """
    Pretvara nazive rocnosti u zajednicki oblik, npr. 3, 3.0 i '3m' -> '3m'.
    """

    text = str(column_name).strip().lower().replace(" ", "")

    try:
        numeric_value = float(text)

        if numeric_value.is_integer():
            return f"{int(numeric_value)}m"

    except ValueError:
        pass

    return text


def _find_required_column(columns, accepted_names):
    """
    Pronalazi kolonu nezavisno od razmaka, donjih crta i velikih/malih slova.
    """

    accepted_keys = {
        _normalise_column_name(name)
        for name in accepted_names
    }

    for column in columns:

        if _normalise_column_name(column) in accepted_keys:
            return column

    raise KeyError(
        "Nedostaje jedna od obaveznih kolona: "
        f"{accepted_names}."
    )


def _to_month_start(values, label):
    """
    Pretvara datume u prvi dan meseca kako bi poredjenje bilo mesecno.
    """

    raw_values = pd.Series(
        list(values)
    )

    parsed_dates = pd.to_datetime(
        raw_values,
        errors="coerce"
    )

    raw_text = raw_values.astype(str).str.strip()

    dayfirst_mask = raw_text.str.match(
        r"^\d{1,2}[./]\d{1,2}[./]\d{2,4}$"
    )

    if dayfirst_mask.any():
        parsed_dates.loc[dayfirst_mask] = pd.to_datetime(
            raw_values.loc[dayfirst_mask],
            errors="coerce",
            dayfirst=True
        )

    missing_mask = parsed_dates.isna()

    if missing_mask.any():
        parsed_dates.loc[missing_mask] = pd.to_datetime(
            raw_values.loc[missing_mask],
            errors="coerce",
            dayfirst=True
        )

    if parsed_dates.isna().any():
        raise ValueError(
            f"Kolona {label} sadrzi datume koje nije moguce parsirati."
        )

    return pd.DatetimeIndex(
        parsed_dates
    ).to_period("M").to_timestamp()


def load_rdns_forecast_sheet(
    file_path,
    sheet_name,
    maturity_names
):
    """
    Ucitava RDNS_h1 ili RDNS_h6 sheet i vraca prognoze u istom redosledu
    rocnosti kao RF/XGBoost matrice.
    """

    raw_sheet = pd.read_excel(
        file_path,
        sheet_name=sheet_name,
        engine="openpyxl"
    )

    raw_sheet.columns = [
        str(column).strip()
        for column in raw_sheet.columns
    ]

    origin_column = _find_required_column(
        raw_sheet.columns,
        ["Forecast_origin", "Forecast origin", "Origin"]
    )

    target_column = _find_required_column(
        raw_sheet.columns,
        ["Target_date", "Target date", "Target"]
    )

    maturity_lookup = {
        _maturity_key(column): column
        for column in raw_sheet.columns
    }

    selected_maturity_columns = []
    missing_maturities = []

    for maturity_name in maturity_names:

        key = _maturity_key(maturity_name)

        if key not in maturity_lookup:
            missing_maturities.append(str(maturity_name))

        else:
            selected_maturity_columns.append(maturity_lookup[key])

    if missing_maturities:
        raise KeyError(
            f"U sheetu {sheet_name} nedostaju RDNS kolone za rocnosti: "
            f"{missing_maturities}."
        )

    rdns_df = pd.DataFrame({
        "Forecast_origin": _to_month_start(
            raw_sheet[origin_column],
            origin_column
        ),
        "Target_date": _to_month_start(
            raw_sheet[target_column],
            target_column
        )
    })

    for maturity_name, source_column in zip(
        maturity_names,
        selected_maturity_columns
    ):
        rdns_df[str(maturity_name)] = pd.to_numeric(
            raw_sheet[source_column],
            errors="coerce"
        )

    maturity_name_strings = [
        str(maturity_name)
        for maturity_name in maturity_names
    ]

    if rdns_df[maturity_name_strings].isna().any().any():
        raise ValueError(
            f"Sheet {sheet_name} sadrzi nedostajuce ili nenumericke "
            "RDNS prognoze."
        )

    if rdns_df["Target_date"].duplicated().any():
        duplicated_targets = (
            rdns_df.loc[
                rdns_df["Target_date"].duplicated(keep=False),
                "Target_date"
            ]
            .dt.strftime("%Y-%m")
            .unique()
            .tolist()
        )

        raise ValueError(
            f"Sheet {sheet_name} ima duplirane target datume: "
            f"{duplicated_targets}."
        )

    return rdns_df.sort_values("Target_date").reset_index(drop=True)


def align_rdns_with_rf_xgb_backtest(
    backtest_result,
    rdns_df,
    data,
    horizon,
    maturity_names
):
    """
    Poravnava RDNS prognoze sa RF/XGBoost prognozama po Target_date
    i proverava da je Forecast_origin tacno Target_date - horizon.
    """

    target_dates = _to_month_start(
        backtest_result["dates"],
        "RF/XGBoost target dates"
    )

    expected_origin_dates = (
        target_dates.to_period("M") - horizon
    ).to_timestamp()

    available_data_periods = set(
        data.index.to_period("M")
    )

    missing_origin_periods = [
        period
        for period in expected_origin_dates.to_period("M")
        if period not in available_data_periods
    ]

    if missing_origin_periods:
        raise ValueError(
            "Neki ocekivani forecast origin datumi nisu prisutni u RF/XGB "
            f"bazi: {missing_origin_periods[:5]}."
        )

    expected_dates_df = pd.DataFrame({
        "Target_date": target_dates,
        "Expected_Forecast_origin": expected_origin_dates,
        "Backtest_position": np.arange(len(target_dates))
    })

    extra_rdns_targets = rdns_df.loc[
        ~rdns_df["Target_date"].isin(expected_dates_df["Target_date"]),
        "Target_date"
    ]

    if len(extra_rdns_targets) > 0:
        print(
            f"Upozorenje: RDNS h={horizon} ima target datume koji nisu "
            "u RF/XGBoost backtest-u i bice ignorisani: "
            f"{extra_rdns_targets.dt.strftime('%Y-%m').tolist()[:10]}"
        )

    aligned = expected_dates_df.merge(
        rdns_df,
        on="Target_date",
        how="left",
        sort=True
    )

    missing_rdns_targets = aligned.loc[
        aligned["Forecast_origin"].isna(),
        "Target_date"
    ]

    if len(missing_rdns_targets) > 0:
        raise ValueError(
            f"RDNS h={horizon} nema prognoze za sledece target datume: "
            f"{missing_rdns_targets.dt.strftime('%Y-%m').tolist()[:10]}."
        )

    origin_matches = (
        aligned["Forecast_origin"].dt.to_period("M")
        == aligned["Expected_Forecast_origin"].dt.to_period("M")
    )

    if not origin_matches.all():
        mismatches = aligned.loc[
            ~origin_matches,
            [
                "Target_date",
                "Expected_Forecast_origin",
                "Forecast_origin"
            ]
        ].copy()

        for column in [
            "Target_date",
            "Expected_Forecast_origin",
            "Forecast_origin"
        ]:
            mismatches[column] = mismatches[column].dt.strftime("%Y-%m")

        raise ValueError(
            f"RDNS h={horizon} Forecast_origin nije uskladjen sa "
            "Target_date - horizon. Prvih nekoliko gresaka:\n"
            f"{mismatches.head(10).to_string(index=False)}"
        )

    positions = aligned["Backtest_position"].astype(int).to_numpy()

    maturity_name_strings = [
        str(maturity_name)
        for maturity_name in maturity_names
    ]

    alignment_table = aligned[
        [
            "Target_date",
            "Expected_Forecast_origin",
            "Forecast_origin"
        ]
    ].copy()

    alignment_table["Target_date"] = (
        alignment_table["Target_date"].dt.strftime("%Y-%m")
    )

    alignment_table["Expected_Forecast_origin"] = (
        alignment_table["Expected_Forecast_origin"].dt.strftime("%Y-%m")
    )

    alignment_table["Forecast_origin"] = (
        alignment_table["Forecast_origin"].dt.strftime("%Y-%m")
    )

    return {
        "target_dates": pd.DatetimeIndex(aligned["Target_date"]),
        "origin_dates": pd.DatetimeIndex(aligned["Forecast_origin"]),
        "actual": np.asarray(backtest_result["actual"])[positions],
        "rf": np.asarray(backtest_result["rf"])[positions],
        "xgb": np.asarray(backtest_result["xgb"])[positions],
        "rdns": aligned[maturity_name_strings].to_numpy(dtype=float),
        "alignment_table": alignment_table
    }


def _holm_adjustment_allowing_nan(p_values):
    """
    Holm korekcija uz ocuvanje NaN p-vrednosti ako se neki DM test ne izracuna.
    """

    p_values = np.asarray(p_values, dtype=float)
    adjusted = np.full_like(
        p_values,
        np.nan,
        dtype=float
    )

    valid = np.isfinite(p_values)

    if valid.any():
        adjusted[valid] = holm_adjustment(
            p_values[valid]
        )

    return adjusted


def evaluate_dm_pair(
    aligned_result,
    horizon,
    maturity_names,
    model_1_key,
    model_2_key,
    model_1_label,
    model_2_label
):
    """
    DM test za dva proizvoljna modela iz aligned_result recnika.

    Znak DM statistike:
      DM > 0  -> model_2 ima manji prosecan gubitak;
      DM < 0  -> model_1 ima manji prosecan gubitak.
    """

    actual = aligned_result["actual"]
    model_1_prediction = aligned_result[model_1_key]
    model_2_prediction = aligned_result[model_2_key]

    error_model_1 = actual - model_1_prediction
    error_model_2 = actual - model_2_prediction

    overall_rmse_model_1 = np.sqrt(
        np.mean(error_model_1 ** 2)
    )

    overall_rmse_model_2 = np.sqrt(
        np.mean(error_model_2 ** 2)
    )

    curve_loss_model_1 = np.mean(
        error_model_1 ** 2,
        axis=1
    )

    curve_loss_model_2 = np.mean(
        error_model_2 ** 2,
        axis=1
    )

    curve_dm = modified_dm_test(
        loss_rf=curve_loss_model_1,
        loss_xgb=curve_loss_model_2,
        forecast_horizon=horizon
    )

    if np.isnan(curve_dm["p_value"]):
        curve_conclusion = "Test statistic could not be calculated"

    elif curve_dm["p_value"] >= 0.05:
        curve_conclusion = "No statistically significant difference"

    elif curve_dm["dm_statistic"] > 0:
        curve_conclusion = (
            f"{model_2_label} has significantly lower forecast loss"
        )

    else:
        curve_conclusion = (
            f"{model_1_label} has significantly lower forecast loss"
        )

    summary = {
        "Comparison": f"{model_1_label} vs {model_2_label}",
        "Horizon": horizon,
        "Number_of_forecasts": len(actual),
        "Model_1": model_1_label,
        "Model_2": model_2_label,
        "Model_1_RMSE": overall_rmse_model_1,
        "Model_2_RMSE": overall_rmse_model_2,
        "Mean_loss_difference_Model_1_minus_Model_2": (
            curve_dm["mean_loss_difference"]
        ),
        "DM_statistic": curve_dm["dm_statistic"],
        "DM_p_value": curve_dm["p_value"],
        "Conclusion": curve_conclusion
    }

    maturity_rows = []

    for maturity_index, maturity_name in enumerate(maturity_names):

        loss_model_1_maturity = (
            error_model_1[:, maturity_index] ** 2
        )

        loss_model_2_maturity = (
            error_model_2[:, maturity_index] ** 2
        )

        maturity_dm = modified_dm_test(
            loss_rf=loss_model_1_maturity,
            loss_xgb=loss_model_2_maturity,
            forecast_horizon=horizon
        )

        maturity_rows.append({
            "Maturity": maturity_name,
            "Model_1": model_1_label,
            "Model_2": model_2_label,
            "Model_1_RMSE": np.sqrt(
                np.mean(loss_model_1_maturity)
            ),
            "Model_2_RMSE": np.sqrt(
                np.mean(loss_model_2_maturity)
            ),
            "Mean_loss_difference_Model_1_minus_Model_2": (
                maturity_dm["mean_loss_difference"]
            ),
            "DM_statistic": maturity_dm["dm_statistic"],
            "p_value_raw": maturity_dm["p_value"]
        })

    maturity_table = pd.DataFrame(maturity_rows)

    maturity_table["p_value_Holm"] = _holm_adjustment_allowing_nan(
        maturity_table["p_value_raw"].values
    )

    maturity_conclusions = []

    for _, row in maturity_table.iterrows():

        if not np.isfinite(row["p_value_Holm"]):
            conclusion = "Test statistic could not be calculated"

        elif row["p_value_Holm"] >= 0.05:
            conclusion = "No significant difference"

        elif row["DM_statistic"] > 0:
            conclusion = model_2_label

        else:
            conclusion = model_1_label

        maturity_conclusions.append(conclusion)

    maturity_table["Significantly_better_model"] = maturity_conclusions

    return summary, maturity_table


